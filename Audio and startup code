This is the code for the soundtracks through the speaker. Each click is a new track, with a blank for no sound. Recommend setting up to run at boot. Can edit volume through code.
-The audio files are downloadable via our github and are labled as they are within the code. Note your file location will be different.


import RPi.GPIO as GPIO
import time
import subprocess

# === Configuration ===
BUTTON_PIN = 17  # GPIO 17 (pin 11)
tracks = [
    None,  # Silent slot
    "/home/COCCedu2024/Downloads/mariosoundtrack.mp3",
    "/home/COCCedu2024/Downloads/carsoundtrack.mp3",
    "/home/COCCedu2024/Downloads/katyperrysoundtrack.mp3"
 
]
track_index = 0
player_process = None
volume_control = "Master"  # Works with 3.5mm jack + PAM8406 amp

# === Setup ===
GPIO.setmode(GPIO.BCM)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)

print("Ready! Playing first track. Press the button to cycle through.")

def stop_current_track():
    global player_process
    if player_process is not None:
        player_process.terminate()
        player_process = None

def play_current_track():
    global player_process
    current_track = tracks[track_index]
    subprocess.call(["amixer", "set", volume_control, "70%"], stderr=subprocess.DEVNULL)
    if current_track:
        print(f"Looping: {current_track}")
        player_process = subprocess.Popen(
            ["mpg123", "--loop", "-1", current_track],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    else:
        print("Silent slot – no sound.")

try:
    play_current_track()

    while True:
        if GPIO.input(BUTTON_PIN) == GPIO.LOW:
            stop_current_track()
            track_index = (track_index + 1) % len(tracks)
            play_current_track()
            time.sleep(0.4)  # debounce
        time.sleep(0.05)
except KeyboardInterrupt:
    print("Shutting down...")
finally:
    stop_current_track()
    GPIO.cleanup()
